{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server"
      ],
      "enabled": true
    },
    "knowledge-engine": {
      "type": "local",
      "command": [
        "node",
        "--env-file=/home/maukerja/Dev/knowledge-engine/.env",
        "/home/maukerja/Dev/knowledge-engine/dist/mcp-server.js"
      ],
      "enabled": true
    }
  }
}
