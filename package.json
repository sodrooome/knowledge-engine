{
  "name": "knowledge-engine",
  "version": "0.1.1",
  "description": "Personal knowledge engine with semantic search over Obsidian vaults",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/main.js",
    "smoke": "tsc && node --env-file=.env dist/smoke.js",
    "index": "tsc && node --env-file=.env dist/index-cli.js",
    "query": "tsc && node --env-file=.env dist/query-cli.js",
    "mcp-server": "tsc && node --env-file=.env dist/mcp-server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.22.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "apache-arrow": "^18.1.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@rolldown/binding-darwin-x64": "^1.1.5",
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "knowledge-management",
    "semantic-search",
    "obsidian",
    "embeddings"
  ],
  "license": "MIT"
}
